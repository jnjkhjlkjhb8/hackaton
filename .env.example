DATABASE_URL=postgres://user:password@database.example:5432/farm?sslmode=require
HTTP_ADDR=:8080
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_USERNAME=host-telemetry-consumer
MQTT_PASSWORD=replace-with-dynamic-security-password
# Dedicated Dynamic Security administrator for automatic Master credential provisioning.
DYNSEC_MQTT_BROKER_URL=ssl://mosquitto:8883
DYNSEC_MQTT_USERNAME=host-dynsec-manager
DYNSEC_MQTT_PASSWORD=replace-with-dynsec-manager-password
DYNSEC_CA_FILE=/run/secrets/mosquitto-ca.crt
# Required to protect POST /v1/admin/master-enrollments with Cloudflare Access.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=replace-with-access-application-audience
CLOUDFLARE_TUNNEL_TOKEN=replace-with-tunnel-token
